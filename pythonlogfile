# Configure the log file, severity level, and format
logging.basicConfig(
    filename='app.log', 
    filemode='a', # 'a' to append logs, 'w' to overwrite the file each run
    format='%(asctime)s - %(levelname)s - %(message)s',
    level=logging.INFO # Keeps INFO, WARNING, ERROR, and CRITICAL logs
)

# Test the logging
logging.info("The application has started.")
logging.warning("This is a warning message!")
logging.error("An unexpected error occurred.")
